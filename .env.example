# Copy this file to .env and adjust the values if needed
BASE_URL=http://opencart.abstracta.us
# chromium | firefox | webkit
BROWSER=chromium
# Optional: use an installed browser instead of the Playwright one (chrome, msedge). Empty = Playwright Chromium
BROWSER_CHANNEL=
HEADLESS=true
# Milliseconds between Playwright actions (useful to watch the run with HEADLESS=false)
SLOW_MO=0
# Timeout for each browser action, in seconds (the demo site can be slow)
TIMEOUT=45
# Record a Playwright trace (.zip) per scenario and attach it to Allure: always | on_failure | off
TRACING=always
# Record a video per scenario and attach it to Allure: true | false
RECORD_VIDEO=false
